# =============================================================================
# Retail IQ — environment template. Copy to `.env` and override for your stack.
# Dev defaults below are SAFE for local docker-compose only. For production set
# real secrets (the app refuses to boot with default secrets when ENVIRONMENT
# is production/staging — see app/config.validate_security()).
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=salesuser
POSTGRES_PASSWORD=salespass            # CHANGE in prod
POSTGRES_DB=salesdb
DATABASE_URL=postgresql+asyncpg://salesuser:salespass@postgres:5432/salesdb

# Defense-in-depth: run the authenticated request path as the non-owner app_rw
# role so Postgres FORCE-RLS enforces tenant isolation (migration 020). ON here.
USE_RLS_ROLE=true
# RLS_DATABASE_URL=postgresql+asyncpg://app_rw:<app_rw_pw>@postgres:5432/salesdb

# Diagnostics worker connects as the least-privilege worker_rw role (migration 029).
WORKER_DB_PASSWORD=worker_rw_dev_pass   # CHANGE in prod

# Sage NL->SQL runs as the least-privilege sage_ro role (migration 023).
# SAGE_DATABASE_URL=postgresql+asyncpg://sage_ro:<sage_ro_pw>@postgres:5432/salesdb

# ── Redis (sessions/blacklist, rate-limit, cache, pub/sub, BullMQ) ────────────
REDIS_PASSWORD=sales_redis_dev_pass     # CHANGE in prod; required (requirepass)
REDIS_URL=redis://:sales_redis_dev_pass@redis:6379

# ── Secrets (MUST be strong, >=32 chars, in production) ───────────────────────
JWT_SECRET_KEY=your-secret-key-change-in-production
SECRET_KEY=your-app-secret-change-in-production
ENVIRONMENT=development                 # development | staging | production

# ── Auth / security posture ───────────────────────────────────────────────────
# Fail CLOSED on Redis outage (reject if the token blacklist can't be checked).
AUTH_FAIL_OPEN_ON_REDIS_DOWN=false
# Trust X-Forwarded-For ONLY behind a proxy that sets it (nginx/LB). OFF by default.
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
MAX_BODY_SIZE_MB=10
# CSP connect-src for the API (override per environment in prod)
# CSP_CONNECT_SRC='self' https://api.example.com wss://api.example.com

# ── Security alerting (high/critical events → email + webhook). No-op until set ─
# Works with any SMTP (e.g. Gmail: smtp.gmail.com:587 + an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SECURITY_ALERT_EMAIL_FROM=
SECURITY_ALERT_EMAIL_TO=
SECURITY_ALERT_WEBHOOK_URL=             # Slack/Discord/Teams incoming webhook
SECURITY_ALERT_MIN_SEVERITY=high        # critical | high | medium | low | info

# ── Diagnostics worker notifications (Track B) ────────────────────────────────
NOTIFY_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=high
DIAGNOSTICS_INTERVAL_MS=300000

# ── LLM provider for Sage / assistant (optional; rule-based fallback if unset) ─
OLLAMA_URL=                             # e.g. http://ollama:11434 (compose profile "ai")
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── Observability (optional, env-gated; nothing leaves the stack unless set) ───
SENTRY_DSN=
POSTHOG_API_KEY=

# ── Branding / misc ───────────────────────────────────────────────────────────
PRODUCT_NAME=Retail IQ
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
STREAMING_INTERVAL_SECONDS=10
FORECAST_DAYS=30

# ── Production modes & feature flags ──────────────────────────────────────────
# These are "auto": unset => enabled in development, disabled in production
# (see app/config.py::_resolve_mode_defaults + docs/production/ENVIRONMENT.md).
# In local dev you can leave them all unset. Listed here for discoverability.
#
# DEMO_MODE=true                 # synthetic demo data master switch
# SAMPLE_DATA_ENABLED=true       # seed synthetic historical data (needs DEMO_MODE)
# LIVE_GENERATOR_ENABLED=true    # synthetic live sale generator (needs DEMO_MODE)
# ALLOW_DEMO_USERS=true          # demo logins (MUST be false in production)
# RUN_MIGRATIONS_ON_STARTUP=true # API applies migrations on boot (prod: use migrate job)
# RUN_SEED_ON_STARTUP=true       # API seeds on boot (prod: use seed job)
# RUN_EMPLOYEE_SEEDER_ON_STARTUP=true
# RUN_CACHE_WARMER=true
# RUN_FORECAST_TRAINER=true
# EXPOSE_API_DOCS=true           # /docs, /redoc, /openapi.json (prod: off unless protected)
# ENABLE_SIGNUP=true
# ENABLE_PUBLIC_API=true
# ENABLE_EXTERNAL_AI=false       # 3rd-party LLM — OFF unless explicitly enabled
# ENABLE_LOCAL_AI=true           # local Ollama
# ENABLE_DATA_SOURCE_CONNECTORS=true  # prod: off unless explicitly enabled
# REQUIRE_EMAIL_VERIFICATION=false    # prod default: true
# REQUIRE_MFA_FOR_ADMINS=false
# WORKER_DATABASE_URL=postgresql+asyncpg://worker_rw:<pw>@postgres:5432/salesdb
# REDIS_SELF_HOSTED=false        # set true when you run your own Redis (forces a password)
# ALLOW_INSECURE_NO_RLS=false    # dangerous: allow prod boot without the RLS role

# ── UAE SaaS commercial control plane (Track 7) ──────────────────────────────
# ENFORCE_USAGE_QUOTAS=false      # Phase 3: when true, over-plan-limit actions get 429 (default: meter only)
# PLATFORM_SUPPLIER_NAME=Retail IQ FZ-LLC   # Phase 4: the "from" legal name on VAT invoices (DRAFT — set real value)
# PLATFORM_SUPPLIER_TRN=100000000000003     # Phase 4: platform TRN on invoices (DRAFT — UAE legal/tax review required)
# Payment gateways are recognised but gated until configured (none wired yet):
# TELR_API_KEY= / STRIPE_API_KEY= / PAYTABS_API_KEY= / NETWORK_API_KEY= / CHECKOUT_API_KEY=
# E-invoicing: built-in 'mock' clearing house works with no key; real UAE gateways gated:
# ZATCA_API_KEY= / UAE_FTA_API_KEY=   # Phase 5 (DRAFT — UAE e-invoicing accreditation required)
# NOTIFY_DEFAULT_EMAIL=false          # Phase 7: in-app notifications always on; email is a logged stub

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SSE_URL=http://localhost:8000/stream/sales
