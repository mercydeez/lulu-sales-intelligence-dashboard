# =============================================================================
# Retail IQ — PRODUCTION environment template.
# Copy to `.env.production` (gitignored) and fill in REAL secrets. The app
# refuses to boot in production/staging on insecure config — see
# app/config.py::validate_security() and docs/production/ENVIRONMENT.md.
#
# DO NOT COMMIT real secrets. Every value marked <...> must be replaced.
# =============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_JSON=true

# ── Secrets (MUST be strong, >= 32 chars) ─────────────────────────────────────
JWT_SECRET_KEY=<generate-a-strong-random-64-char-secret>
SECRET_KEY=<generate-a-different-strong-random-64-char-secret>

# ── Database (owner role — migrations/admin) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<owner>:<strong-pw>@<db-host>:5432/<db>

# ── Tenant isolation: REQUIRED in production ──────────────────────────────────
# Run the request path as the non-owner app_rw role so Postgres FORCE-RLS
# enforces tenant isolation (migrations 020/021). Boot fails if this is off,
# unless you set ALLOW_INSECURE_NO_RLS=true (NOT recommended).
USE_RLS_ROLE=true
RLS_DATABASE_URL=postgresql+asyncpg://app_rw:<strong-app_rw-pw>@<db-host>:5432/<db>
# ALLOW_INSECURE_NO_RLS=false

# ── Least-privilege role connections ──────────────────────────────────────────
SAGE_DATABASE_URL=postgresql+asyncpg://sage_ro:<strong-sage_ro-pw>@<db-host>:5432/<db>
WORKER_DATABASE_URL=postgresql+asyncpg://worker_rw:<strong-worker-pw>@<db-host>:5432/<db>

# ── Redis (token blacklist, rate-limit, cache, pub/sub) ───────────────────────
# If you self-host Redis, REDIS_SELF_HOSTED=true forces a password requirement.
# Managed Redis (Render, etc.) supplies an authenticated URL — leave self-hosted false.
REDIS_SELF_HOSTED=true
REDIS_PASSWORD=<strong-redis-password>
REDIS_URL=redis://:<strong-redis-password>@<redis-host>:6379

# ── Network / browser security ────────────────────────────────────────────────
CORS_ORIGINS=https://app.yourdomain.com
CSP_CONNECT_SRC='self' https://api.yourdomain.com wss://api.yourdomain.com
TRUST_PROXY_HEADERS=true            # true ONLY behind a proxy that strips inbound XFF
AUTH_FAIL_OPEN_ON_REDIS_DOWN=false

# ── Production modes: demo behavior OFF, startup work OFF ──────────────────────
# Leave these unset to inherit the safe production defaults. They are listed so
# the intent is explicit. Do NOT enable demo flags on a real-tenant deployment.
DEMO_MODE=false
SAMPLE_DATA_ENABLED=false
LIVE_GENERATOR_ENABLED=false
ALLOW_DEMO_USERS=false
RUN_MIGRATIONS_ON_STARTUP=false     # run the dedicated `migrate` job instead
RUN_SEED_ON_STARTUP=false
EXPOSE_API_DOCS=false               # only enable behind a protected proxy route
ENABLE_DATA_SOURCE_CONNECTORS=false
ENABLE_EXTERNAL_AI=false            # set true only with an explicit policy + key
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_MFA_FOR_ADMINS=true

# ── Optional integrations (no-op unless set) ──────────────────────────────────
OPENAI_API_KEY=
SENTRY_DSN=
SECURITY_ALERT_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# ── E0-2 uptime monitoring + alerting ─────────────────────────────────────────
# Turn alerting ON and point the webhook at an external provider that pages the
# founder phone (<5 min). ALERT_WEBHOOK_URL is a SECRET — never commit the real URL.
# Recommended: an external monitor also polls /health/ready every 60s (see runbook).
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_MIN_SEVERITY=critical
ALERT_DEDUP_TTL_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_STALE_SECONDS=120
BACKUP_MANIFEST_PATH=/backups/latest.json
BACKUP_STALE_AFTER_HOURS=30

# ── E5-1a SSO / OIDC (enterprise login) ───────────────────────────────────────
# Enable per pilot. Configure providers in tenant_sso_providers (docs/security/SSO.md).
# The client secret is a SECRET — set the env var named by client_secret_env, e.g.
# SSO_AZURE_CLIENT_SECRET=... (never commit it). Keep trust_idp_mfa=false so admin
# MFA cannot be bypassed via SSO unless you explicitly opt a provider in.
SSO_ENABLED=false
SSO_OIDC_ENABLED=false
SSO_STATE_TTL_SECONDS=600
SSO_JWKS_CACHE_TTL_SECONDS=3600
SSO_REQUIRE_VERIFIED_EMAIL=true
SSO_DEFAULT_ROLE=analyst
SSO_TRUST_IDP_MFA_DEFAULT=false
SSO_ALLOWED_REDIRECT_HOSTS=app.yourdomain.com
SSO_MAX_RETURN_TO_LENGTH=500
# SSO_AZURE_CLIENT_SECRET=            # example per-provider secret (name matches client_secret_env)

# ── E5-1c SCIM enterprise provisioning ────────────────────────────────────────
# Enable per pilot. Create SCIM tokens via POST /api/scim/admin/tokens (admin only);
# tokens are hashed at rest and shown once. Keep admin-role mapping OFF.
SCIM_ENABLED=false
SCIM_TOKEN_TTL_DAYS=365
SCIM_DEFAULT_ROLE=analyst
SCIM_ALLOW_ADMIN_ROLE_MAPPING=false
SCIM_GROUP_MAPPING_ENABLED=false
SCIM_MAX_PAGE_SIZE=100
SCIM_DEACTIVATE_REVOKES_TOKENS=true
SCIM_ALLOW_REACTIVATION=true
SCIM_AUDIT_ENABLED=true

PRODUCT_NAME=Retail IQ

# ── Frontend (set to the deployed URLs) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SSE_URL=https://api.yourdomain.com/stream/sales
